rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica se o usuário autenticado é admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'icaroregis@gmail.com';
    }

    // Usuários autorizados — leitura pública para verificação de acesso
    // Escrita: admin pode tudo; usuário pode atualizar apenas o próprio campo uid
    match /authorized_users/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
      allow update: if request.auth != null
        && request.auth.token.email == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'photoURL', 'linkEnabled']);
    }

    // Coleções — leitura por qualquer usuário autenticado (painel de trocas)
    // Escrita: próprio usuário, admin, ou qualquer usuário autenticado (necessário para aceite de trocas,
    // onde o receptor precisa atualizar a coleção do remetente na mesma transação)
    match /collections/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Repetidas — idem
    match /duplicates/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Propostas de troca — qualquer usuário autenticado pode criar/ler
    // Apenas os participantes (fromUid ou toUid) ou admin podem atualizar
    match /trade_proposals/{proposalId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid ||
        isAdmin()
      );
    }

    // Propostas externas (via link público) — qualquer pessoa pode criar
    // Leitura: qualquer usuário autenticado pode listar (filtro feito no cliente)
    // Edição/exclusão: apenas o destinatário ou admin
    match /external_proposals/{propId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.toUid || isAdmin()
      );
    }

    // Movimentos financeiros — cada usuário lê/escreve apenas os próprios; admin pode tudo
    match /financial_movements/{movId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
    }
  }
}
