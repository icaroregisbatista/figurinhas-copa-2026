rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuários autorizados — leitura pública para verificação de acesso
    // Escrita: admin pode tudo; usuário pode atualizar apenas o próprio campo uid
    match /authorized_users/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'icaroregis@gmail.com';
      allow update: if request.auth != null
        && request.auth.token.email == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);
    }

    // Coleções — cada usuário lê/escreve apenas a própria
    // Leitura por outros usuários autorizados (para painel de trocas)
    match /collections/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Repetidas — idem
    match /duplicates/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
